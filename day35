q35)Problem: Queue Using Array - Implement using linked list with dynamic memory allocation.

Input:
- First line: integer n (number of elements)
- Second line: n space-separated integers

Output:
- Print queue elements from front to rear, space-separated

Example:
Input:
5
10 20 30 40 50

Output:
10 20 30 40 50

Explanation:
Use array and front/rear pointers. Enqueue inserts at rear, dequeue removes from front. Display from front to rear.

  code:
#include <stdio.h>
#define MAX 1000

int queue[MAX];
int front = 0, rear = -1;

// Enqueue
void enqueue(int x) {
    if (rear == MAX - 1) {
        printf("Queue Overflow\n");
        return;
    }
    queue[++rear] = x;
}

// Display
void display() {
    if (front > rear) {
        printf("Queue is empty");
        return;
    }

    for (int i = front; i <= rear; i++) {
        printf("%d", queue[i]);
        if (i != rear)
            printf(" ");
    }
}

int main() {
    int n, x;

    scanf("%d", &n);

    // Enqueue all elements
    for (int i = 0; i < n; i++) {
        scanf("%d", &x);
        enqueue(x);
    }

    // Display queue
    display();

    return 0;
}
